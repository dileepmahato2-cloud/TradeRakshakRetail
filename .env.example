# =============================================================================
# TradeRakshak™ v11.5 — Environment Configuration (Java/Angular migration)
# Copy to .env and fill before running INSTALL.bat
# NEVER commit .env to version control
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────────
SPRING_PROFILE=dev

# ── Database ───────────────────────────────────────────────────────────────────
# Dev (SQLite — default):
DATABASE_URL=jdbc:postgresql://localhost:5432/traderakshak
DB_DRIVER=org.postgresql.Driver

# Prod (PostgreSQL — uncomment and fill):
# DATABASE_URL=jdbc:postgresql://postgres:5432/traderakshak
# DB_DRIVER=org.postgresql.Driver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# ── Security (BRD §17) — CHANGE ALL IN PRODUCTION ────────────────────────────
# JWT secret — minimum 32 chars, random
JWT_SECRET=tr-v114-CHANGE-THIS-to-a-random-32chars-min

# Fernet key for PAN encryption — generate ONCE:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OR (Java): openssl rand -base64 32
FERNET_KEY=

# ── SMTP Email ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@traderakshak.in
SMTP_PASSWORD=

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Payment Gateway Mode ───────────────────────────────────────────────────────
# Set to "live" for production, "test" for sandbox/testing
PAYMENT_GATEWAY_MODE=test

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live credentials (used when PAYMENT_GATEWAY_MODE=live)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ── BillDesk ──────────────────────────────────────────────────────────────────
BILLDESK_MERCHANT_ID=
BILLDESK_SECRET_KEY=
BILLDESK_CLIENT_ID=
BILLDESK_RETURN_URL=http://localhost:8080/api/payments/billdesk/callback
# Live credentials (used when PAYMENT_GATEWAY_MODE=live)
BILLDESK_LIVE_MERCHANT_ID=
BILLDESK_LIVE_SECRET_KEY=
BILLDESK_LIVE_CLIENT_ID=
BILLDESK_LIVE_RETURN_URL=

# ── MSG91 (SMS OTP) ────────────────────────────────────────────────────────────
MSG91_API_KEY=
MSG91_SENDER_ID=TRDRK
MSG91_OTP_TEMPLATE_ID=

# ── Google reCAPTCHA v3 ────────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Storage paths ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
BACKUP_DIR=./backups
ARCHIVE_DIR=./archive
DATA_DIR=./data
MAX_FILE_SIZE_MB=1
MAX_BATCH_FILES=250
LOCAL_DATA_PATH=E:/Share Market/Stock for Server/Stock Market Application

# ── Rate limits (BRD §17 L5) ──────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_UPLOAD=20

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PORT=8080
CORS_ORIGINS=http://localhost:8080
